# EditorConfig — consistent whitespace across editors for this multi-file-type
# repo (Python, YAML policies, JSON fixtures, Markdown docs). Conventions match
# the ruff config in pyproject.toml (line length 100). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[Makefile]
indent_style = tab

# Markdown: two trailing spaces are a meaningful line break, so do not strip them.
[*.md]
trim_trailing_whitespace = false
